# Turso Database Configuration (libSQL)
# Replace with your actual Turso database URL and Auth Token
# Run:
#   turso db create project-manage
#   turso db show project-manage --url
#   turso db tokens create project-manage

VITE_TURSO_DATABASE_URL=libsql://your-db-name.turso.io
VITE_TURSO_AUTH_TOKEN=your-turso-auth-token
